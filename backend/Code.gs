/* Deploy as a standalone Apps Script Web App. See SETUP.md. */
function props_(){return PropertiesService.getScriptProperties();}
function db_(){return SpreadsheetApp.openById(props_().getProperty('SHEET_ID'));}
function doGet(){return HtmlService.createHtmlOutputFromFile('Admin').setTitle('Ranowin Production · Admin').addMetaTag('viewport','width=device-width, initial-scale=1');}
function digest_(v){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,v).map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join('');}
// Run once from the editor after setting ADMIN_PASSWORD and the other properties.
function setupAdmin_(){const p=props_(),pw=p.getProperty('ADMIN_PASSWORD');if(!pw||pw.length<16)throw Error('Set a unique ADMIN_PASSWORD of at least 16 characters.');const salt=Utilities.getUuid();p.setProperties({PASSWORD_SALT:salt,PASSWORD_HASH:digest_(salt+pw)});p.deleteProperty('ADMIN_PASSWORD');const db=db_();if(!db.getSheetByName('Materials'))db.insertSheet('Materials').appendRow(['ID','Bag','Color','Image','Qty','ShowLowStock','Active','DriveFile']);if(!db.getSheetByName('Sales'))db.insertSheet('Sales').appendRow(['Reference','MaterialID','Qty','Date']);}
function login(user,password){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const cache=CacheService.getScriptCache(),p=props_(),key='attempts',count=Number(cache.get(key)||0);if(count>=10)throw Error('Too many attempts. Try again in 15 minutes.');cache.put(key,String(count+1),900);if(user!==p.getProperty('ADMIN_USER')||digest_(p.getProperty('PASSWORD_SALT')+password)!==p.getProperty('PASSWORD_HASH'))throw Error('Incorrect username or password.');const token=Utilities.getUuid()+Utilities.getUuid();cache.put('session:'+digest_(props_().getProperty('PASSWORD_SALT')+token),'yes',21600);cache.remove(key);return token;}finally{lock.releaseLock();}}
function auth_(token){if(!token||CacheService.getScriptCache().get('session:'+digest_(props_().getProperty('PASSWORD_SALT')+token))!=='yes')throw Error('Session expired. Please log in.');}
function logout(token){if(token)CacheService.getScriptCache().remove('session:'+digest_(props_().getProperty('PASSWORD_SALT')+token));}
function materialRows_(){const s=db_().getSheetByName('Materials');return s.getLastRow()<2?[]:s.getRange(2,1,s.getLastRow()-1,8).getValues().map(r=>({id:r[0],bag:r[1],color:r[2],image:r[3],qty:r[4]===''?null:Number(r[4]),show:r[5]===true,active:r[6]===true,drive:r[7]}));}
function getData(token){auth_(token);return {showLowStock:props_().getProperty('SHOW_LOW_STOCK')!=='false',products:catalog_(),materials:materialRows_()};}
function github_(method,path,data){const p=props_();const res=UrlFetchApp.fetch('https://api.github.com/repos/'+p.getProperty('GITHUB_REPO')+'/'+path,{method:method,headers:{Authorization:'Bearer '+p.getProperty('GITHUB_TOKEN'),Accept:'application/vnd.github+json'},contentType:'application/json',payload:data?JSON.stringify(data):undefined,muteHttpExceptions:true});if(res.getResponseCode()>=300)throw Error('GitHub sync failed ('+res.getResponseCode()+'). Your Sheet data is retained; use Retry sync.');return JSON.parse(res.getContentText()||'{}');}
function putFile_(path,base64){let sha;try{sha=github_('get','contents/'+encodeURIComponent(path)).sha;}catch(e){/* New files have no SHA; a failed write still surfaces below. */}return github_('put','contents/'+encodeURIComponent(path),{message:'Admin: update '+path,content:base64,sha:sha});}
function sync_(){const materials=materialRows_();const text=JSON.stringify({version:1,catalogVersion:2,updatedAt:new Date().toISOString(),showLowStock:props_().getProperty('SHOW_LOW_STOCK')!=='false',products:catalog_(),materials:materials.map(({drive,...rest})=>rest)});putFile_('stock.json',Utilities.base64Encode(text,Utilities.Charset.UTF_8));}
function retrySync(token){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{sync_();return 'Synced';}finally{l.releaseLock();}}
function qty_(v){if(v===''||v===null)return '';const n=Number(v);if(!Number.isInteger(n)||n<0||n>100000)throw Error('Qty must be a whole number, zero or more.');return n;}
function saveMaterial(token,input){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{pendingStockGuard_();const s=db_().getSheetByName('Materials'),rows=materialRows_();const old=rows.find(r=>r.id===input.id);const bag=String(input.bag||'').trim(),color=String(input.color||'').trim();if((!bag||bag.length>120||/^[=+@-]/.test(bag))||! /^[A-Za-z][A-Za-z ]{0,30}$/.test(color))throw Error('Choose a product and an English color name.');if(old&&(old.bag!==bag||old.color!==color))throw Error('To move a design, deactivate it and add it under the new bag/color.');const product=db_().getSheetByName('Sheet1'),data=product.getDataRange().getDisplayValues(),row=data.findIndex(r=>r[0]===bag);if(row<1)throw Error('Product not found.');let image=old?old.image:String(input.image||'').trim(),drive=old?old.drive:'';const id=old?old.id:(/^[a-f0-9-]{36}$/i.test(input.id||'')?input.id:Utilities.getUuid());if(input.photo){if(input.photo.length>4000000||! /^data:image\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(input.photo))throw Error('Invalid image. Use the photo picker.');const bytes=Utilities.base64Decode(input.photo.split(',')[1]);const filename='material-'+id+'-'+Utilities.getUuid()+'.jpg';const f=DriveApp.getFolderById(props_().getProperty('DRIVE_FOLDER_ID')).createFile(Utilities.newBlob(bytes,'image/jpeg',filename));drive=f.getId();putFile_('uploads/'+filename,input.photo.split(',')[1]);image='uploads/'+filename;}if(!image||! /^(https:\/\/|[\w .\/-]+\.(png|jpe?g|webp)$)/i.test(image)||image.includes('..'))throw Error('Provide a valid image URL or upload a photo.');const record=[id,bag,color,image,qty_(input.qty),input.show===true,input.active!==false,drive];if(old)s.getRange(rows.indexOf(old)+2,1,1,8).setValues([record]);else s.appendRow(record);
// Add any color column without shifting existing data.
const heads=data[0],header=color+' Patterns';let col=heads.indexOf(header);if(col<0){col=heads.findIndex((h,i)=>i>=11&&!h&&data.every(r=>!r[i]));if(col<0){col=product.getLastColumn();if(col>=product.getMaxColumns())product.insertColumnAfter(product.getMaxColumns());}product.getRange(1,col+1).setValue(header);}
const oldImage=old?old.image:String(input.image||'').trim();let images=String(product.getRange(row+1,col+1).getValue()||'').split(/[|;\n]+/).map(x=>x.trim()).filter(Boolean);if(oldImage)images=images.filter(x=>x!==oldImage);if(input.active!==false&&!images.includes(image))images.push(image);product.getRange(row+1,col+1).setValue(images.join(' | '));const ci=heads.indexOf('ColorOptions');if(ci<0)throw Error('Missing ColorOptions header.');const colors=String(product.getRange(row+1,ci+1).getValue()).split(',').map(x=>x.trim()).filter(Boolean);if(input.active!==false&&!colors.some(c=>c.toLowerCase()===color.toLowerCase()))colors.push(color);product.getRange(row+1,ci+1).setValue(colors.join(','));SpreadsheetApp.flush();sync_();return getData(token);}finally{l.releaseLock();}}
function confirmSale(token,id,count,reference){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{pendingStockGuard_();const n=qty_(count);if(!n)throw Error('Sale quantity must be at least 1.');const ref=String(reference||'').trim();if(!/^[\w -]{3,80}$/.test(ref))throw Error('Enter a unique order reference (3–80 letters/numbers).');const sales=db_().getSheetByName('Sales'),log=sales.getDataRange().getDisplayValues();if(log.some(r=>r[0]===ref))throw Error('This order reference was already confirmed.');const rows=materialRows_(),i=rows.findIndex(r=>r.id===id),r=rows[i];if(!r||!r.active||r.qty===null||r.qty<n)throw Error('Not enough tracked stock.');db_().getSheetByName('Materials').getRange(i+2,5).setValue(r.qty-n);sales.appendRow([ref,id,n,new Date()]);SpreadsheetApp.flush();sync_();return getData(token);}finally{l.releaseLock();}}

function category_(name,value){return String(value||'').trim()||(/^baby bag\s*\d+$/i.test(name)?'Baby Bags':/^toys?\s*\d+$/i.test(name)?'Toys':String(name).replace(/\s*\d+\s*$/,'').trim()||'Other items');}
function catalog_(){const data=db_().getSheetByName('Sheet1').getDataRange().getDisplayValues(),h=data.shift(),at=(r,k)=>r[h.indexOf(k)]||'';return data.map((r,i)=>({id:at(r,'ID')||'bag-'+(i+1),name:r[0],category:category_(r[0],at(r,'Category')),price:at(r,'Price'),delivery:at(r,'DeliveryFee'),status:at(r,'Status'),images:['ImageLink','ImageLink2','ImageLink3'].map(k=>at(r,k)),size:at(r,'Size'),descriptions:{en:at(r,'DescriptionEN'),si:at(r,'DescriptionSI'),ta:at(r,'DescriptionTA')},colors:at(r,'ColorOptions'),patterns:Object.fromEntries(h.map((k,j)=>[k,r[j]]).filter(([k])=>/ Patterns$/.test(k))),qty:at(r,'ProductQty')===''?null:Number(at(r,'ProductQty')),show:at(r,'ShowLowStock').toLowerCase()==='true',active:at(r,'Active').toLowerCase()!=='false',custom:at(r,'CustomOrder')?at(r,'CustomOrder').toLowerCase()==='true':/bag/i.test(r[0])})).filter(r=>r.name);}
function schema_(){const s=db_().getSheetByName('Sheet1');let headers=s.getRange(1,1,1,s.getLastColumn()).getDisplayValues()[0];for(const name of ['ID','Category','Size','ProductQty','ShowLowStock','Active','CustomOrder'])if(!headers.includes(name)){if(headers.length>=s.getMaxColumns())s.insertColumnAfter(s.getMaxColumns());s.getRange(1,headers.length+1).setValue(name);headers.push(name);}const idcol=headers.indexOf('ID')+1;if(s.getLastRow()>1){const vals=s.getRange(2,1,s.getLastRow()-1,headers.length).getDisplayValues();vals.forEach((r,i)=>{if(r[0]&&!r[idcol-1])s.getRange(i+2,idcol).setValue('bag-'+(i+1));});}return headers;}
function upgradeCatalog(token){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{schema_();return getData(token);}finally{l.releaseLock();}}
function text_(v,max){const x=String(v||'').trim();if(x.length>max||/^[=+@-]/.test(x))throw Error('Text is too long or starts with a spreadsheet formula character.');return x;}
function money_(v){if(v===''||v===null||v===undefined)return '';const n=Number(v);if(!Number.isFinite(n)||n<0||n>10000000)throw Error('Enter a valid price / delivery fee.');return n;}
function uploadPhoto_(photo,prefix){if(!photo||photo.length>4000000||!/^data:image\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(photo))throw Error('Invalid photo.');const name=prefix+'-'+Utilities.getUuid()+'.jpg';DriveApp.getFolderById(props_().getProperty('DRIVE_FOLDER_ID')).createFile(Utilities.newBlob(Utilities.base64Decode(photo.split(',')[1]),'image/jpeg',name));putFile_('uploads/'+name,photo.split(',')[1]);return 'uploads/'+name;}
function saveProduct(token,input){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{pendingStockGuard_();const h=schema_(),s=db_().getSheetByName('Sheet1'),data=s.getDataRange().getDisplayValues(),idcol=h.indexOf('ID');let row=data.findIndex((r,i)=>i>0&&r[idcol]===input.id);const old=row>0?data[row]:null;if(input.id&&!old&&!/^product-[a-f0-9-]{36}$/i.test(input.id))throw Error('Product was not found. Refresh and try again.');const name=text_(input.name,120),category=text_(input.category,80);if(!name)throw Error('Enter a product name.');if(data.some((r,i)=>i>0&&i!==row&&r[0].toLowerCase()===name.toLowerCase()))throw Error('A product with this name already exists.');const id=old?old[idcol]:(input.id||'product-'+Utilities.getUuid()),images=(input.images||[]).slice(0,3);for(let i=0;i<3;i++){images[i]=text_(images[i],1500);if(images[i]&&!/^(https:\/\/|[\w .\/-]+\.(png|jpe?g|webp)$)/i.test(images[i]))throw Error('Use an image filename or HTTPS URL.');if(input.photos&&input.photos[i])images[i]=uploadPhoto_(input.photos[i],'product');}const status=input.status==='Out of Stock'?'Out of Stock':'In Stock';const fields={Name:name,ID:id,Category:category_ (name,category),Price:money_(input.price),DeliveryFee:money_(input.delivery),Status:status,ImageLink:images[0],ImageLink2:images[1],ImageLink3:images[2],DescriptionEN:text_(input.descriptions?.en,5000),DescriptionSI:text_(input.descriptions?.si,5000),DescriptionTA:text_(input.descriptions?.ta,5000),ColorOptions:text_(input.colors,300),Size:text_(input.size,80),ProductQty:qty_(input.qty),ShowLowStock:input.show===true,Active:input.active!==false,CustomOrder:input.custom===true};if(!old)row=s.getLastRow();if(row>=s.getMaxRows())s.insertRowAfter(s.getMaxRows());for(const [key,value] of Object.entries(fields)){const col=h.indexOf(key);if(col<0)throw Error('Missing Sheet header: '+key);s.getRange(row+1,col+1).setValue(value);}if(old&&old[0]!==name){const materials=materialRows_();materials.forEach((m,i)=>{if(m.bag===old[0])db_().getSheetByName('Materials').getRange(i+2,2).setValue(name);});}SpreadsheetApp.flush();sync_();return getData(token);}finally{l.releaseLock();}}
function renameCategory(token,from,to){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{pendingStockGuard_();const name=text_(to,80);if(!name)throw Error('Enter the new category name.');const h=schema_(),s=db_().getSheetByName('Sheet1'),rows=s.getDataRange().getDisplayValues();rows.forEach((r,i)=>{if(i&&r[0]&&category_(r[0],r[h.indexOf('Category')])===from)s.getRange(i+1,h.indexOf('Category')+1).setValue(name);});SpreadsheetApp.flush();sync_();return getData(token);}finally{l.releaseLock();}}
function confirmProductSale(token,id,count,reference){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{pendingStockGuard_();const n=qty_(count),ref=String(reference||'').trim();if(!n||!/^[\w -]{3,80}$/.test(ref))throw Error('Enter a positive quantity and unique reference.');const sales=db_().getSheetByName('Sales');if(sales.getDataRange().getDisplayValues().some(r=>r[0]===ref))throw Error('This reference was already confirmed.');const p=catalog_().find(p=>p.id===id);if(!p||!p.active||p.qty===null||p.qty<n)throw Error('Not enough tracked product stock.');const h=schema_(),s=db_().getSheetByName('Sheet1'),rows=s.getDataRange().getDisplayValues(),row=rows.findIndex(r=>r[h.indexOf('ID')]===id);s.getRange(row+1,h.indexOf('ProductQty')+1).setValue(p.qty-n);sales.appendRow([ref,'product:'+id,n,new Date()]);SpreadsheetApp.flush();sync_();return getData(token);}finally{l.releaseLock();}}

function setLowStock(token,enabled){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{props_().setProperty('SHOW_LOW_STOCK',enabled===true?'true':'false');sync_();return getData(token);}finally{l.releaseLock();}}

// Remove a material from the catalog. Original photos and historical sales are retained.
function deleteMaterial(token,input){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{pendingStockGuard_();const materials=materialRows_(),record=input.id?materials.find(m=>m.id===input.id):null;if(input.id&&!record)throw Error('Material was already removed. Refresh the panel.');const bag=record?record.bag:String(input.bag||''),color=record?record.color:String(input.color||''),image=record?record.image:String(input.image||'');if(!bag||!color||!image)throw Error('Choose a material to delete.');const s=db_().getSheetByName('Sheet1'),data=s.getDataRange().getDisplayValues(),row=data.findIndex((r,i)=>i>0&&r[0]===bag),col=data[0].findIndex(h=>h.toLowerCase()===(color+' Patterns').toLowerCase());if(row<1||col<0)throw Error('Product or color was not found.');const files=String(data[row][col]||'').split(/[|;\n]+/).map(v=>v.trim()).filter(Boolean).filter(v=>v!==image);s.getRange(row+1,col+1).setValue(files.join(' | '));const sheet=db_().getSheetByName('Materials');for(let i=materials.length-1;i>=0;i--){const m=materials[i];if(m.bag===bag&&m.color.toLowerCase()===color.toLowerCase()&&m.image===image)sheet.deleteRow(i+2);}SpreadsheetApp.flush();sync_();return getData(token);}finally{l.releaseLock();}}

// Customer orders live in a separate, unpublished spreadsheet; never included by sync_().
function ordersDB_(){const id=props_().getProperty('ORDERS_SHEET_ID');if(!id)throw Error('Activate private orders first.');if(id===props_().getProperty('SHEET_ID'))throw Error('Orders must use a separate private spreadsheet.');return SpreadsheetApp.openById(id);}
function activateOrders(token){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{if(!props_().getProperty('ORDERS_SHEET_ID')){const d=SpreadsheetApp.create('Ranowin Private Orders');d.getSheets()[0].setName('Orders').appendRow(['ID','Data']);props_().setProperty('ORDERS_SHEET_ID',d.getId());}return getOrders(token);}finally{l.releaseLock();}}
function orderRows_(){const s=ordersDB_().getSheetByName('Orders');if(!s)throw Error('Private Orders sheet is missing.');return s.getLastRow()<2?[]:s.getRange(2,1,s.getLastRow()-1,2).getValues().map((r,i)=>({row:i+2,value:JSON.parse(r[1])}));}
function writeOrder_(o,row){const json=JSON.stringify(o);if(json.length>45000)throw Error('Order history is full; archive this order before adding more entries.');const s=ordersDB_().getSheetByName('Orders');if(row)s.getRange(row,1,1,2).setValues([[o.id,json]]);else s.appendRow([o.id,json]);SpreadsheetApp.flush();}
function getOrders(token){auth_(token);return {orders:orderRows_().map(r=>r.value).sort((a,b)=>b.created.localeCompare(a.created)),managerItems:managerItems_(),settings:JSON.parse(props_().getProperty('MANAGER_SETTINGS')||'{}')};}
function requiredText_(v,max,label){const s=text_(v,max);if(!s)throw Error(label+' is required.');return s;}
function cents_(v){if(v===''||v==null)throw Error('Enter an amount, including zero where applicable.');const n=money_(v);return Math.round(n*100);}
function orderTotals_(o){const goods=o.lines.reduce((n,x)=>n+x.qty*x.price,0),delivery=o.delivery;const receipts=o.payments.filter(p=>!p.voided);return {goods,delivery,total:goods+delivery,goodsReceived:receipts.reduce((n,p)=>n+p.goods,0),deliveryReceived:receipts.reduce((n,p)=>n+p.delivery,0),fees:receipts.reduce((n,p)=>n+p.fee,0),cash:receipts.reduce((n,p)=>n+p.goods+p.delivery-p.fee,0)};}
function orderEvent_(o,action){o.updated=new Date().toISOString();o.version++;o.history.push({date:o.updated,action});}
function saveOrder(token,input){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{const found=orderRows_().find(r=>r.value.id===input.id),old=found?.value;if(old&&(old.version!==input.version||old.status!=='Draft'||old.stockJournal))throw Error('Refresh: only the current draft can be edited.');if(!Array.isArray(input.lines)||!input.lines.length||input.lines.length>20)throw Error('Add 1–20 product lines.');const products=catalog_(),materials=materialRows_();const lines=input.lines.map(x=>{const p=products.find(p=>p.id===x.product);if(!p||!p.active)throw Error('Product unavailable.');const qty=qty_(x.qty);if(!qty||qty>99)throw Error('Quantity must be 1–99.');const m=x.material?materials.find(m=>m.id===x.material&&m.bag===p.name&&m.active):null;if(x.material&&!m)throw Error('Material unavailable.');return {product:p.id,name:p.name,material:m?.id||'',color:m?.color||text_(x.color,60),pattern:m?.image||text_(x.pattern,1500),qty,price:cents_(x.price),managerItem:text_(x.managerItem,100)||managerItems_()[p.id]||''};});const o={id:old?.id||'RW-'+Utilities.getUuid(),created:old?.created||new Date().toISOString(),invoiceDate:old?.invoiceDate||Utilities.formatDate(new Date(),'Asia/Colombo','yyyy-MM-dd'),updated:'',version:old?.version||0,status:'Draft',customer:requiredText_(input.customer,150,'Customer'),phone:requiredText_(input.phone,60,'Phone'),address:requiredText_(input.address,1500,'Address'),notes:text_(input.notes,1500),delivery:cents_(input.delivery),managerCustomer:text_(input.managerCustomer,100),managerImported:false,lines,payments:[],history:old?.history||[],tracking:'',dispatched:'',stockApplied:false};orderEvent_(o,'Draft saved');writeOrder_(o,found?.row);return getOrders(token);}finally{l.releaseLock();}}
function stockPlan_(o,direction){const products=catalog_(),materials=materialRows_(),totals={};o.lines.forEach(x=>{const p=products.find(p=>p.id===x.product),m=materials.find(m=>m.id===x.material);if(!p||!p.active||(x.material&&(!m||!m.active)))throw Error('Order product or material is no longer active. Edit the draft first.');let key;if(m&&m.qty!==null)key='m:'+m.id;else if(p&&p.qty!==null)key='p:'+p.id;if(key)totals[key]=(totals[key]||0)+x.qty;});return Object.entries(totals).map(([key,n])=>{const m=key.startsWith('m:')?materials.find(m=>m.id===key.slice(2)):null,p=m?null:products.find(p=>p.id===key.slice(2)),before=m?m.qty:p.qty,after=before+direction*n;if(after<0)throw Error('Not enough tracked stock for '+(m?m.bag+' / '+m.color:p.name));return {key,before,after};});}
// A persisted target journal makes a retry safe after an interrupted Sheet write.
function finishStock_(o,row){if(!o.stockJournal)return;const h=schema_(),s=db_().getSheetByName('Sheet1'),rows=s.getDataRange().getDisplayValues(),materials=materialRows_();for(const t of o.stockJournal.targets){let range;if(t.key.startsWith('m:')){const i=materials.findIndex(m=>m.id===t.key.slice(2));if(i<0)throw Error('Stock recovery needs the deleted material restored.');range=db_().getSheetByName('Materials').getRange(i+2,5);}else{const i=rows.findIndex(r=>r[h.indexOf('ID')]===t.key.slice(2));if(i<1)throw Error('Stock recovery product missing.');range=s.getRange(i+1,h.indexOf('ProductQty')+1);}const now=Number(range.getValue());if(now!==t.before&&now!==t.after)throw Error('Stock changed during an interrupted order. Resolve stock before retrying.');if(now===t.before)range.setValue(t.after);}SpreadsheetApp.flush();if(o.stockJournal.direction===-1)o.stockTargets=o.stockJournal.targets.map(t=>({key:t.key,qty:t.before-t.after}));o.stockApplied=o.stockJournal.direction===-1;o.status=o.stockJournal.nextStatus;delete o.stockJournal;orderEvent_(o,o.stockApplied?'Confirmed; tracked stock deducted':'Stock returned');writeOrder_(o,row);}
function changeOrder(token,id,version,input){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{const r=orderRows_().find(r=>r.value.id===id);if(!r)throw Error('Order not found.');const o=r.value;if(o.version!==version)throw Error('Order changed on another device. Refresh first.');if(o.stockJournal){finishStock_(o,r.row);}else if(input.action==='confirm'){pendingStockGuard_();if(o.status!=='Draft')throw Error('Only drafts can be confirmed.');const targets=stockPlan_(o,-1);o.stockJournal={targets,direction:-1,nextStatus:'Confirmed'};writeOrder_(o,r.row);finishStock_(o,r.row);}else if(input.action==='restock'){pendingStockGuard_();if(!['Cancelled','Returned'].includes(o.status)||!o.stockApplied)throw Error('Only cancelled / returned stock can be restored once.');o.stockJournal={targets:restorePlan_(o),direction:1,nextStatus:o.status};writeOrder_(o,r.row);finishStock_(o,r.row);}else{if(input.action==='dispatch'){if(!['Confirmed','Dispatched'].includes(o.status))throw Error('Confirm the order before dispatch.');const tracking=requiredText_(input.tracking,100,'Barcode');if(orderRows_().some(r=>r.value.id!==id&&r.value.tracking===tracking))throw Error('Barcode is used by another order.');o.tracking=tracking;o.dispatched=validDate_(input.date);o.status='Dispatched';}else if(input.action==='status'){if(!['Delivered','Cancelled','Returned'].includes(input.status))throw Error('Invalid status.');const allowed={Delivered:['Dispatched'],Cancelled:['Draft','Confirmed'],Returned:['Dispatched','Delivered']};if(!allowed[input.status].includes(o.status))throw Error('Invalid order status transition.');o.status=input.status;}else if(input.action==='manager'){o.managerCustomer=requiredText_(input.customer,100,'Manager Customer ID');if(!/^[a-f0-9-]{36}$/i.test(o.managerCustomer))throw Error('Use the Manager Customer UUID from its export.');o.managerImported=input.imported===true;}else throw Error('Unknown action.');orderEvent_(o,input.action+' '+o.status);writeOrder_(o,r.row);}let syncWarning='';if(['confirm','restock','recover'].includes(input.action)){try{sync_();}catch(e){syncWarning=e.message;}}return {...getOrders(token),syncWarning};}finally{l.releaseLock();}}
function validDate_(v){if(!/^\d{4}-\d{2}-\d{2}$/.test(v||'')||(isNaN(Date.parse(v+'T00:00:00Z'))||new Date(v+'T00:00:00Z').toISOString().slice(0,10)!==v))throw Error('Choose a valid date.');return v;}
function recordOrderPayment(token,id,version,input){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{const all=orderRows_(),r=all.find(r=>r.value.id===id);if(!r||r.value.version!==version)throw Error('Refresh the order first.');const o=r.value;if(o.stockJournal)throw Error('Finish stock recovery first.');if(input.voidID){const p=o.payments.find(p=>p.id===input.voidID);if(!p||p.voided)throw Error('Payment not found or already voided.');p.voided=true;p.voidReason=requiredText_(input.reason,300,'Reason');}else{if(!['Confirmed','Dispatched','Delivered'].includes(o.status))throw Error('Payments require an active confirmed order.');const goods=cents_(input.goods),delivery=cents_(input.delivery),fee=cents_(input.fee),t=orderTotals_(o);if(goods+delivery<=0||fee>goods+delivery)throw Error('Check the payment and postal deduction.');if(goods+t.goodsReceived>t.goods||delivery+t.deliveryReceived>t.delivery)throw Error('Payment exceeds the outstanding amount.');const receipt=requiredText_(input.receipt,100,'Payment reference');if(all.some(r=>r.value.payments.some(p=>!p.voided&&p.receipt===receipt&&r.value.id===id)))throw Error('This payment reference is already recorded for this order.');o.payments.push({id:Utilities.getUuid(),receipt,date:validDate_(input.date),goods,delivery,fee,voided:false});}orderEvent_(o,input.voidID?'Payment voided':'Payment recorded');writeOrder_(o,r.row);return getOrders(token);}finally{l.releaseLock();}}
function saveManagerSettings(token,input){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{const result={};for(const k of ['salesAccount','deliveryItem','theme']){result[k]=text_(input[k],100);if(result[k]&&!/^[a-f0-9-]{36}$/i.test(result[k]))throw Error(k+' must be a Manager UUID.');}props_().setProperty('MANAGER_SETTINGS',JSON.stringify(result));return getOrders(token);}finally{l.releaseLock();}}
function tsvCell_(v){const s=String(v??'');return /[\t\r\n"]/.test(s)?'"'+s.replace(/"/g,'""')+'"':s;}
function managerInvoiceExport(token,id,preview){auth_(token);const o=orderRows_().find(r=>r.value.id===id)?.value;if(!o||(o.status==='Draft'&&preview!==true)||['Cancelled','Returned'].includes(o.status)||o.stockJournal)throw Error('Choose an active confirmed order.');if(o.managerImported)throw Error('Already marked imported. Unmark only after checking Manager for duplicates.');if(!/^[a-f0-9-]{36}$/i.test(o.managerCustomer))throw Error('Create / find the customer in Manager, then save their Customer UUID.');const cfg=JSON.parse(props_().getProperty('MANAGER_SETTINGS')||'{}'),record={IssueDate:o.invoiceDate||o.created.slice(0,10),Reference:preview===true?'TEST-'+o.id:o.id,Customer:o.managerCustomer,BillingAddress:o.customer+'\n'+o.address+'\n'+o.phone,Description:(preview===true?'TEST PREVIEW — do not create this invoice. ':'')+o.notes,HasLineDescription:true,AutomaticReference:false};const lines=o.lines.map(x=>({item:x.managerItem||managerItems_()[x.product]||'',description:x.name+' / '+x.color+(x.pattern?' / '+x.pattern:''),qty:x.qty,price:x.price}));if(o.delivery)lines.push({item:cfg.deliveryItem,description:'Delivery Fee',qty:1,price:o.delivery});lines.forEach((x,i)=>{const base='Lines.'+(i+1)+'.';if(!x.item&&!cfg.salesAccount)throw Error('Set a Manager item on every line (including delivery), or configure a sales Account UUID.');record[base+'Item']=x.item||'';if(!x.item)record[base+'Account']=cfg.salesAccount;record[base+'LineDescription']=x.description;record[base+'Qty']=x.qty;record[base+'SalesUnitPrice']=(x.price/100).toFixed(2);});if(cfg.theme){record.HasSalesInvoiceCustomTheme=true;record.SalesInvoiceCustomTheme=cfg.theme;}return Object.keys(record).map(tsvCell_).join('\t')+'\n'+Object.values(record).map(tsvCell_).join('\t');}

function restorePlan_(o){const materials=materialRows_(),products=catalog_();return (o.stockTargets||[]).map(t=>{const r=t.key.startsWith('m:')?materials.find(m=>m.id===t.key.slice(2)):products.find(p=>p.id===t.key.slice(2));if(!r||r.qty===null)throw Error('Restore the original tracked item before returning this order to stock.');if(r.qty+t.qty>100000)throw Error('Returned stock exceeds the supported quantity limit.');return {key:t.key,before:r.qty,after:r.qty+t.qty};});}
function pendingStockGuard_(){if(props_().getProperty('ORDERS_SHEET_ID')&&orderRows_().some(r=>r.value.stockJournal))throw Error('Recover the interrupted order stock update in Orders before editing inventory.');}

// Customer Batch Create uses only current fields in the owner's supplied template.
function managerCustomerExport(token,id){auth_(token);const o=orderRows_().find(r=>r.value.id===id)?.value;if(!o)throw Error('Order not found.');if(o.managerCustomer)throw Error('A Manager customer is already linked. Reuse it instead of creating a duplicate.');if(['Cancelled','Returned'].includes(o.status))throw Error('Choose an active order.');const address=o.address+'\nPhone: '+o.phone,record={Name:o.customer,Code:o.id,BillingAddress:address,DeliveryAddress:address,Inactive:false};return Object.keys(record).map(tsvCell_).join('\t')+'\n'+Object.values(record).map(tsvCell_).join('\t');}
function parseManagerTSV_(text){if(typeof text!=='string'||!text.trim()||text.length>2000000)throw Error('Paste a Customers Batch Update export (maximum 2 MB).');const rows=[];let row=[],cell='',quoted=false;for(let i=0;i<text.length;i++){const c=text[i];if(c==='"'){if(quoted&&text[i+1]==='"'){cell+='"';i++;}else if(quoted){quoted=false;}else if(!cell){quoted=true;}else{cell+=c;}}else if(c==='\t'&&!quoted){row.push(cell);cell='';}else if((c==='\n'||c==='\r')&&!quoted){if(c==='\r'&&text[i+1]==='\n')i++;row.push(cell);if(row.some(v=>v!==''))rows.push(row);row=[];cell='';}else cell+=c;}if(quoted)throw Error('Export has an unclosed quote. Copy it again without editing.');if(cell||row.length){row.push(cell);rows.push(row);}if(!rows.length)throw Error('Export is empty.');rows[0][0]=rows[0][0].replace(/^\uFEFF/,'');const h=rows.shift();if(new Set(h).size!==h.length)throw Error('Duplicate columns in export.');return {headers:h,rows};}
function linkManagerCustomerExport(token,id,version,text){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{const found=orderRows_().find(r=>r.value.id===id),o=found?.value;if(!o||o.version!==version)throw Error('Order changed; refresh first.');if(o.stockJournal)throw Error('Recover stock first.');if(o.managerCustomer)throw Error('Customer already linked. Use the existing Manager link.');const parsed=parseManagerTSV_(text),h=parsed.headers,ci=h.indexOf('Code'),ki=h.indexOf('Key');if(ci<0||ki<0||!h.includes('Name'))throw Error('Use Customers > Batch Update export, including Name, Code and Key headers.');const matching=parsed.rows.filter(r=>String(r[ci]||'').trim()===o.id);if(matching.length!==1)throw Error(matching.length?'Duplicate customer codes found in Manager. Resolve them before linking.':'No matching customer Code found. Import the customer first, then export that customer from Batch Update.');const uuid=String(matching[0][ki]||'').trim();if(!/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(uuid))throw Error('Customer Key is not a valid UUID.');o.managerCustomer=uuid;orderEvent_(o,'Manager customer linked by exported Code');writeOrder_(o,found.row);return getOrders(token);}finally{l.releaseLock();}}

// Product-to-Manager links are private admin settings, never public catalog fields.
function managerItems_(){return JSON.parse(props_().getProperty('MANAGER_ITEMS')||'{}');}
function writeManagerItems_(map){const json=JSON.stringify(map);if(json.length>8000)throw Error('Too many Manager mappings for this settings store.');props_().setProperty('MANAGER_ITEMS',json);}
function importManagerItems(token,text){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{const parsed=parseManagerTSV_(text),h=parsed.headers,code=h.indexOf('ItemCode'),key=h.indexOf('Key'),name=h.indexOf('ItemName'),inactive=h.indexOf('Inactive');if(code<0||key<0||name<0)throw Error('Paste Inventory Items Batch Update export including ItemCode, ItemName and Key.');const byCode={};for(const row of parsed.rows){const c=String(row[code]||'').trim();if(!c)continue;if(/^(true|1)$/i.test(String(row[inactive]||'')))continue;const id=String(row[key]||'').trim();if(!/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(id))throw Error('Invalid Manager item Key for '+c);if(byCode[c])throw Error('Duplicate ItemCode in export: '+c);byCode[c]={id,name:String(row[name]||'')};}const map=managerItems_(),matched=[],unmatched=[];for(const p of catalog_()){const m=/^baby\s+bag\s+(\d+)$/i.exec(p.name.trim());if(!m)continue;const c=m[1].padStart(3,'0'),item=byCode[c];if(item&&/^baby\s+bag$/i.test(item.name.trim())){map[p.id]=item.id;matched.push(p.name);}else unmatched.push(p.name);}const cfg=JSON.parse(props_().getProperty('MANAGER_SETTINGS')||'{}');const delivery=byCode.DELIVERY;if(!matched.length&&!delivery)throw Error('No matching Baby Bag codes or DELIVERY item. Use manual product links for other categories.');writeManagerItems_(map);if(delivery){cfg.deliveryItem=delivery.id;props_().setProperty('MANAGER_SETTINGS',JSON.stringify(cfg));}return {...getOrders(token),mappingReport:{matched,unmatched,delivery:!!delivery}};}finally{l.releaseLock();}}
function saveManagerItemLink(token,product,id){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{if(!catalog_().some(p=>p.id===product))throw Error('Product not found.');const v=text_(id,100);if(v&&!/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(v))throw Error('Paste the Manager item Key UUID.');const map=managerItems_();if(v)map[product]=v;else delete map[product];writeManagerItems_(map);return getOrders(token);}finally{l.releaseLock();}}
