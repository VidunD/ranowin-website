/* Deploy as a standalone Apps Script Web App. See SETUP.md. */
function props_(){return PropertiesService.getScriptProperties();}
function db_(){return SpreadsheetApp.openById(props_().getProperty('SHEET_ID'));}
function doGet(){return HtmlService.createHtmlOutputFromFile('Admin').setTitle('Ranowin Production · Admin').addMetaTag('viewport','width=device-width, initial-scale=1');}
function digest_(v){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,v).map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join('');}
// Run once from the editor after setting ADMIN_PASSWORD and the other properties.
function setupAdmin_(){const p=props_(),pw=p.getProperty('ADMIN_PASSWORD');if(!pw||pw.length<16)throw Error('Set a unique ADMIN_PASSWORD of at least 16 characters.');const salt=Utilities.getUuid();p.setProperties({PASSWORD_SALT:salt,PASSWORD_HASH:digest_(salt+pw)});p.deleteProperty('ADMIN_PASSWORD');const db=db_();if(!db.getSheetByName('Materials'))db.insertSheet('Materials').appendRow(['ID','Bag','Color','Image','Qty','ShowLowStock','Active','DriveFile']);if(!db.getSheetByName('Sales'))db.insertSheet('Sales').appendRow(['Reference','MaterialID','Qty','Date']);}
function login(user,password){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const cache=CacheService.getScriptCache(),p=props_(),key='attempts',count=Number(cache.get(key)||0);if(count>=10)throw Error('Too many attempts. Try again in 15 minutes.');cache.put(key,String(count+1),900);if(user!==p.getProperty('ADMIN_USER')||digest_(p.getProperty('PASSWORD_SALT')+password)!==p.getProperty('PASSWORD_HASH'))throw Error('Incorrect username or password.');const token=Utilities.getUuid()+Utilities.getUuid();cache.put('session:'+digest_(props_().getProperty('PASSWORD_SALT')+token),'yes',21600);cache.remove(key);return token;}finally{lock.releaseLock();}}
function auth_(token){if(!token||CacheService.getScriptCache().get('session:'+digest_(props_().getProperty('PASSWORD_SALT')+token))!=='yes')throw Error('Session expired. Please log in.');}
function logout(token){if(token)CacheService.getScriptCache().remove('session:'+digest_(props_().getProperty('PASSWORD_SALT')+token));}
function materialRows_(){const s=db_().getSheetByName('Materials');return s.getLastRow()<2?[]:s.getRange(2,1,s.getLastRow()-1,8).getValues().map(r=>({id:r[0],bag:r[1],color:r[2],image:r[3],qty:r[4]===''?null:Number(r[4]),show:r[5]===true,active:r[6]===true,drive:r[7]}));}
function getData(token){auth_(token);const s=db_().getSheetByName('Sheet1'),v=s.getDataRange().getDisplayValues();const heads=v.shift();return {showLowStock:props_().getProperty('SHOW_LOW_STOCK')!=='false',products:v.filter(r=>r[0]).map(r=>({name:r[0],colors:r[heads.indexOf('ColorOptions')],patterns:Object.fromEntries(heads.map((h,i)=>[h,r[i]]).filter(([h])=>/ Patterns$/.test(h)))})),materials:materialRows_()};}
function github_(method,path,data){const p=props_();const res=UrlFetchApp.fetch('https://api.github.com/repos/'+p.getProperty('GITHUB_REPO')+'/'+path,{method:method,headers:{Authorization:'Bearer '+p.getProperty('GITHUB_TOKEN'),Accept:'application/vnd.github+json'},contentType:'application/json',payload:data?JSON.stringify(data):undefined,muteHttpExceptions:true});if(res.getResponseCode()>=300)throw Error('GitHub sync failed ('+res.getResponseCode()+'). Your Sheet data is retained; use Retry sync.');return JSON.parse(res.getContentText()||'{}');}
function putFile_(path,base64){let sha;try{sha=github_('get','contents/'+encodeURIComponent(path)).sha;}catch(e){/* New files have no SHA; a failed write still surfaces below. */}return github_('put','contents/'+encodeURIComponent(path),{message:'Admin: update '+path,content:base64,sha:sha});}
function sync_(){const materials=materialRows_();const text=JSON.stringify({version:1,updatedAt:new Date().toISOString(),showLowStock:props_().getProperty('SHOW_LOW_STOCK')!=='false',products:catalog_(),materials:materials.map(({drive,...rest})=>rest)});putFile_('stock.json',Utilities.base64Encode(text,Utilities.Charset.UTF_8));}
function retrySync(token){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{sync_();return 'Synced';}finally{l.releaseLock();}}
function qty_(v){if(v===''||v===null)return '';const n=Number(v);if(!Number.isInteger(n)||n<0||n>100000)throw Error('Qty must be a whole number, zero or more.');return n;}
function saveMaterial(token,input){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{const s=db_().getSheetByName('Materials'),rows=materialRows_();const old=rows.find(r=>r.id===input.id);const bag=String(input.bag||'').trim(),color=String(input.color||'').trim();if(!/^Baby Bag \d{3}$/.test(bag)||! /^[A-Za-z][A-Za-z ]{0,30}$/.test(color))throw Error('Choose a bag and an English color name.');if(old&&(old.bag!==bag||old.color!==color))throw Error('To move a design, deactivate it and add it under the new bag/color.');const product=db_().getSheetByName('Sheet1'),data=product.getDataRange().getDisplayValues(),row=data.findIndex(r=>r[0]===bag);if(row<1)throw Error('Bag not found.');let image=old?old.image:String(input.image||'').trim(),drive=old?old.drive:'';const id=old?old.id:(/^[a-f0-9-]{36}$/i.test(input.id||'')?input.id:Utilities.getUuid());if(input.photo){if(input.photo.length>4000000||! /^data:image\/jpeg;base64,[A-Za-z0-9+/=]+$/.test(input.photo))throw Error('Invalid image. Use the photo picker.');const bytes=Utilities.base64Decode(input.photo.split(',')[1]);const filename='material-'+id+'-'+Utilities.getUuid()+'.jpg';const f=DriveApp.getFolderById(props_().getProperty('DRIVE_FOLDER_ID')).createFile(Utilities.newBlob(bytes,'image/jpeg',filename));drive=f.getId();putFile_('uploads/'+filename,input.photo.split(',')[1]);image='uploads/'+filename;}if(!image||! /^(https:\/\/|[\w .\/-]+\.(png|jpe?g|webp)$)/i.test(image)||image.includes('..'))throw Error('Provide a valid image URL or upload a photo.');const record=[id,bag,color,image,qty_(input.qty),input.show===true,input.active!==false,drive];if(old)s.getRange(rows.indexOf(old)+2,1,1,8).setValues([record]);else s.appendRow(record);
// Add any color column without shifting existing data.
const heads=data[0],header=color+' Patterns';let col=heads.indexOf(header);if(col<0){col=heads.findIndex((h,i)=>i>=11&&!h&&data.every(r=>!r[i]));if(col<0){col=product.getLastColumn();if(col>=product.getMaxColumns())product.insertColumnAfter(product.getMaxColumns());}product.getRange(1,col+1).setValue(header);}
const oldImage=old?old.image:String(input.image||'').trim();let images=String(product.getRange(row+1,col+1).getValue()||'').split(/[|;\n]+/).map(x=>x.trim()).filter(Boolean);if(oldImage)images=images.filter(x=>x!==oldImage);if(input.active!==false&&!images.includes(image))images.push(image);product.getRange(row+1,col+1).setValue(images.join(' | '));const ci=heads.indexOf('ColorOptions');if(ci<0)throw Error('Missing ColorOptions header.');const colors=String(product.getRange(row+1,ci+1).getValue()).split(',').map(x=>x.trim()).filter(Boolean);if(input.active!==false&&!colors.some(c=>c.toLowerCase()===color.toLowerCase()))colors.push(color);product.getRange(row+1,ci+1).setValue(colors.join(','));SpreadsheetApp.flush();sync_();return getData(token);}finally{l.releaseLock();}}
function confirmSale(token,id,count,reference){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{const n=qty_(count);if(!n)throw Error('Sale quantity must be at least 1.');const ref=String(reference||'').trim();if(!/^[\w -]{3,80}$/.test(ref))throw Error('Enter a unique order reference (3–80 letters/numbers).');const sales=db_().getSheetByName('Sales'),log=sales.getDataRange().getDisplayValues();if(log.some(r=>r[0]===ref))throw Error('This order reference was already confirmed.');const rows=materialRows_(),i=rows.findIndex(r=>r.id===id),r=rows[i];if(!r||!r.active||r.qty===null||r.qty<n)throw Error('Not enough tracked stock.');db_().getSheetByName('Materials').getRange(i+2,5).setValue(r.qty-n);sales.appendRow([ref,id,n,new Date()]);SpreadsheetApp.flush();sync_();return getData(token);}finally{l.releaseLock();}}

function catalog_(){const data=db_().getSheetByName('Sheet1').getDataRange().getDisplayValues(),h=data.shift();return data.filter(r=>r[0]).map(r=>({name:r[0],colors:r[h.indexOf('ColorOptions')],patterns:Object.fromEntries(h.map((k,i)=>[k,r[i]]).filter(([k])=>/ Patterns$/.test(k)))}));}

function setLowStock(token,enabled){auth_(token);const l=LockService.getScriptLock();l.waitLock(30000);try{props_().setProperty('SHOW_LOW_STOCK',enabled===true?'true':'false');sync_();return getData(token);}finally{l.releaseLock();}}
